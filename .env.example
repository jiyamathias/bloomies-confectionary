# Flutterwave (https://app.flutterwave.com → Settings → API keys)
# Use the TEST secret key (FLWSECK_TEST-…) until you're ready to take real payments.
FLW_SECRET_KEY=

# Public address of the site, used for the "return to site" link after payment.
# Optional: if empty, the address of the incoming request is used.
SITE_URL=
