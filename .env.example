# ── Database ─────────────────────────────────────────────────────────────────
# Neon Postgres connection string.
# Example: postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/bloomies?sslmode=require
DATABASE_URL=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# From Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bloomies-assets
# Public URL for your R2 bucket (configure a custom domain or use the r2.dev sub-domain)
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Flutterwave ───────────────────────────────────────────────────────────────
# From https://app.flutterwave.com → Settings → API keys
# Use FLWSECK_TEST-… until you go live.
FLW_SECRET_KEY=
# Secret hash set in Flutterwave dashboard → Webhooks (must match FLW_SECRET_HASH here)
FLW_SECRET_HASH=

# ── Site ──────────────────────────────────────────────────────────────────────
# Full URL of the deployed site (no trailing slash). Used for checkout redirect URLs.
SITE_URL=https://bloomies.vercel.app

# ── Auth ──────────────────────────────────────────────────────────────────────
# Random 32+ character string for signing sessions (run: openssl rand -hex 32)
SESSION_SECRET=
